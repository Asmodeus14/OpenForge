# ---- Server only. Never exposed to the browser.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

# ---- Public. Safe in the client bundle.
# Dedicated Pinata gateway. Measured 172ms warm vs 15s timeouts on public
# gateways for the same CID. The token is read-only and scoped to this gateway.
NEXT_PUBLIC_PINATA_GATEWAY=https://harlequin-secure-quail-563.mypinata.cloud
NEXT_PUBLIC_PINATA_GATEWAY_TOKEN=

# Keyless public Sepolia RPC. Replaces the Infura project key that was
# hardcoded into two source files in the Vite app.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chat backend.
NEXT_PUBLIC_API_URL=https://openforge.onrender.com/api
NEXT_PUBLIC_SOCKET_URL=https://openforge.onrender.com
